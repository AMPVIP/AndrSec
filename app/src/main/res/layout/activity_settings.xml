<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Настройки бота VK"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Токен сообщества VK"
            android:textSize="14sp"
            android:paddingTop="8dp"/>

        <EditText
            android:id="@+id/tokenInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="vk1.a.xxxxx"
            android:inputType="text"
            android:maxLines="1"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ID группы VK (число)"
            android:textSize="14sp"
            android:paddingTop="16dp"/>

        <EditText
            android:id="@+id/groupIdInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="241678909"
            android:inputType="number"
            android:maxLines="1"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Твой ID VK (peer_id)"
            android:textSize="14sp"
            android:paddingTop="16dp"/>

        <EditText
            android:id="@+id/peerIdInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="16004466"
            android:inputType="number"
            android:maxLines="1"/>

        <Button
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Сохранить"/>

        <Button
            android:id="@+id/testBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Проверить (отправить тест)"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textSize="12sp"
            android:textColor="#888"
            android:text="💡 После сохранения перезапустите охрану (снять → поставить), чтобы бот переподключился с новыми настройками."/>
    </LinearLayout>
</ScrollView>