<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== VK ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔑 Токен сообщества VK"
            android:textSize="13sp"
            android:textColor="#888"/>

        <EditText
            android:id="@+id/tokenInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="vk1.a.xxxxx"
            android:inputType="textNoSuggestions"
            android:maxLines="1"
            android:textSize="14sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ID группы"
                    android:textSize="13sp"
                    android:textColor="#888"/>

                <EditText
                    android:id="@+id/groupIdInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="241678909"
                    android:inputType="number"
                    android:maxLines="1"
                    android:textSize="14sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Твой peer_id"
                    android:textSize="13sp"
                    android:textColor="#888"/>

                <EditText
                    android:id="@+id/peerIdInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="16004466"
                    android:inputType="number"
                    android:maxLines="1"
                    android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Детектор движения ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎯 Порог движения (меньше = чувствительнее)"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/sensitivityValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="#2196F3"/>
        </LinearLayout>

        <SeekBar
            android:id="@+id/sensitivitySeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="5"/>

        <!-- ===== Кадры ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📷 Обработка кадров (1 / 2 / 4 / 8)"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/frameSkipValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="~30 fps"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="#2196F3"/>
        </LinearLayout>

        <SeekBar
            android:id="@+id/frameSkipSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="3"
            android:progress="0"/>

        <!-- ===== Тип медиа при тревоге ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🚨 При тревоге отправлять"
            android:textSize="13sp"/>

        <RadioGroup
            android:id="@+id/alarmMediaGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <RadioButton
                android:id="@+id/alarmMediaPhoto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📷 Фото"
                android:textSize="13sp"/>

            <RadioButton
                android:id="@+id/alarmMediaVideo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎥 Видео 10с"
                android:textSize="13sp"/>
        </RadioGroup>

        <!-- ===== Кнопки ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/saveBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Сохранить"/>

            <Button
                android:id="@+id/testBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Тест"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="12sp"
            android:textColor="#888"
            android:text="💡 После сохранения перезапустите охрану (снять → поставить), чтобы бот переподключился."/>
    </LinearLayout>
</ScrollView>